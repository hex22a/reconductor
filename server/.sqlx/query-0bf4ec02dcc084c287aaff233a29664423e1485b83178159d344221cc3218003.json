{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        id,\n                        project_id,\n                        created_at,\n                        target,\n                        status as \"status: ScanStatus\",\n                        schedule,\n                        next_run_at\n                    FROM recon.scans\n                    WHERE project_id=$1 and id < $2\n                    ORDER BY id DESC\n                    LIMIT $3;\n                    ",
