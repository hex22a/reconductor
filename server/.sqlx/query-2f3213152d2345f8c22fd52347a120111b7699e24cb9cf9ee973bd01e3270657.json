  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        id,\n                        host_id,\n                        port,\n                        protocol,\n                        state,\n                        service,\n                        product,\n                        version\n                    FROM recon.scan_ports\n                    WHERE host_id=$1 AND id < $2\n                    ORDER BY id DESC\n                    LIMIT $3;\n                    ",
