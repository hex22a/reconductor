  "query": "\n                    SELECT\n                        id,\n                        scan_run_id,\n                        ip,\n                        mac,\n                        vendor,\n                        hostname,\n                        os_match,\n                        os_accuracy\n                    FROM recon.scan_hosts\n                    WHERE scan_run_id=$1 and id < $2\n                    ORDER BY id DESC\n                    LIMIT $3;\n                    ",
