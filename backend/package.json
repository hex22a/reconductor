{
  "name": "backend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "lint": "bun eslint migration.ts tests/**/*.ts src/**/*.ts",
    "test:unit": "bun test src",
    "test:platform": "bun --env-file=.env.test run test:platform:all",
    "test:platform:up": "podman compose -f ../docker-compose.test.yml up -d",
    "test:platform:down": "podman compose -f ../docker-compose.test.yml down -v",
    "test:platform:migration": "bun run ./db/migration.ts",
    "test:platform:all": "bun run test:platform:up && bun run test:platform:migration && bun test tests/platform --preload ./tests/setup.platform.ts && bun run test:platform:down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.55.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
